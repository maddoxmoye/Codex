config_version=5

[application]
config/name="Wildfall — The Emberwood"
run/main_scene="res://arena.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/description="A native woodland ruin combat study."

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
rendering_device/driver.macos="metal"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.08, 1)
