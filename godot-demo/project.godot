; A standalone Godot graphics study. No Wildfall saves or gameplay are touched.
config_version=5

[application]
config/name="Wildfall • The Moonwell"
run/main_scene="res://moonwell.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A small, automatic 3D diorama for mobile graphics testing."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="disabled"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
scaling_3d/scale=0.75
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
